# Kopier denne filen til «innstillinger.env» (samme mappe) og fjern # foran det du vil bruke.
# innstillinger.env holdes utenfor git. Start årshjulet på nytt etter endringer.

# BOM-ene på en nettverksmappe i stedet for i datamappen:
# ARSHJUL_BOM=\\felles.ansatt.ntnu.no\ntnu\ie\ies\ansatte\evenjc\claude-testing\BOM

# Datamappen (arshjul.db, Bestillingslister, .cache). Standard: mappen over arshjul/
# ARSHJUL_DATA=C:\dev\Innkjøp undervisning

# Bare på server:
# ARSHJUL_MODUS=server
# ARSHJUL_SECRET_KEY=minst-32-tegn-lang-tilfeldig-tekst   (lag med: python -c "import secrets; print(secrets.token_hex(32))")
# ARSHJUL_HOST=127.0.0.1
# ARSHJUL_PORT=5057
